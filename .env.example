# ---------------------------------------------------------------------------
# .env.example —— 部署层（L3）配置样例
#
# 用法：复制为 .env 后按需修改（.env 已被 .gitignore 忽略，切勿入库）。
# 路径值按进程环境 > .env > config/app.yaml 解析；设置值另见 DESIGN §6.2。
# 环境变量覆盖使用「PC__」前缀 + 双下划线分隔层级，对应 DESIGN §6.2.4。
#
# 从 PostgreSQL 换到 SQLite 之后，这里**不再有数据库连接串、端口与密码**：
# 数据库就是数据根目录下的一个文件。
# ---------------------------------------------------------------------------

# --- 数据存放位置（唯一必须关心的部署参数） -------------------------------
# 数据根目录：库文件（pc.sqlite3）、媒体、缩略图、冷层、隔离区、备份都在它下面。
# 留空 = 用平台默认的用户数据目录（DESIGN §10.2）：
#   Windows  %LOCALAPPDATA%\post-collector
#   Linux    $XDG_DATA_HOME/post-collector（缺省 ~/.local/share/post-collector）
#   macOS    ~/Library/Application Support/post-collector
PC_DATA_ROOT=

# 只想挪动数据库文件本身（媒体仍留在数据根目录）时用这个；留空则用
# <PC_DATA_ROOT>/pc.sqlite3
PC__DB__PATH=

# 覆盖某几个子目录的位置（留空 = 从数据根目录派生）：
#   <data_root>/media  media_root        媒体本体（内容寻址 ab/cd/<sha256>）
#   <data_root>/thumbs thumb_root        派生缩略图与 preview，建议留在 SSD（热路径）
#   <data_root>/cold   cold_root         冷层，可指向 NAS
#   <data_root>/quarantine quarantine_root  L2 提报隔离区，必须与 media 物理分离
#   <data_root>/backup backup_root       默认落点不保证异盘，须另设物理介质
PC__PATHS__MEDIA_ROOT=
PC__PATHS__COLD_ROOT=
PC__PATHS__QUARANTINE_ROOT=
# 不传 --to 时，pc db backup 默认写入此目录；留空则用 <data_root>/backup。
# 请填可写的绝对路径并确认属于另一物理介质；相对路径按运行命令的当前目录解析。
PC__PATHS__BACKUP_ROOT=

# --- 行为开关（默认值即「最隐私」侧，勿随意调整） ------------------------
# AI 参与度四档：off | local_only | assist | advisory_auto（默认 local_only）
PC__AI__INVOLVEMENT=local_only
# 内容库最大占用（字节），默认 200 GB
PC__RETENTION__MAX_TOTAL_BYTES=214748364800
# 匿名提报入口默认关闭
PC__INBOX__ENABLED=false

# --- 注意 -----------------------------------------------------------------
# 1) 备份与库放在不同盘上是硬要求（DESIGN §7.1）：单文件是 SQLite 最大的优点，
#    也是它最大的风险点。备份命令：uv run pc db backup
# 2) 本机 Web 已实现经显式逐次确认的模型外发（DESIGN §4.5/§6.3）。
#    上面的 local_only 默认值保持关闭；仅修改配置不会自动启用外发。
# 3) 第三方凭证（阶段 2 的连接器）不放这里，也不放数据库明文列：主密钥进系统
#    密钥库，密文进 credential_secret（见 DESIGN §6.1）。
