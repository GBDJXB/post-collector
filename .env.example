# ---------------------------------------------------------------------------
# .env.example —— 部署层（L3）配置样例
#
# 用法：复制为 .env 后按需修改（.env 已被 .gitignore 忽略，切勿入库）。
# 分层约定见 DESIGN §6.2：L1 设置页 > L2 config/app.yaml > L3 .env / compose。
# 环境变量覆盖使用「PC__」前缀 + 双下划线分隔层级，对应 DESIGN §6.2.4。
# ---------------------------------------------------------------------------

# --- PostgreSQL（docker-compose 的 db 服务使用） --------------------------
POSTGRES_DB=pc
POSTGRES_USER=pc
# 必须修改；首次启动前请换成长随机串
POSTGRES_PASSWORD=change-me

# --- 应用（容器内连接串） -------------------------------------------------
PC__DB__DSN=postgresql://pc:change-me@db:5432/pc
PC__PATHS__MEDIA_ROOT=/data/media
PC__PATHS__COLD_ROOT=/data/cold
PC__PATHS__QUARANTINE_ROOT=/data/quarantine

# --- 行为开关（默认值即「最隐私」侧，勿随意调整） ------------------------
# AI 参与度四档：off | local_only | assist | advisory_auto（默认 local_only）
PC__AI__INVOLVEMENT=local_only
# 内容库最大占用（字节），默认 200 GB
PC__RETENTION__MAX_TOTAL_BYTES=214748364800
# 匿名提报入口默认关闭
PC__INBOX__ENABLED=false

# --- 注意 -----------------------------------------------------------------
# 本阶段（骨架）不存在任何 AI 外发代码路径，因此这里没有外发相关变量。
# 阶段 2 引入外发网关时，相关开关必须经由「待审队列 + 服务商策略登记」，
# 见 DESIGN §6.3，并同步更新本文件的注释。
